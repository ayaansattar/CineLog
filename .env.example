TMDB_API_KEY=your_tmdb_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Local SQLite (relative to prisma/ via Prisma)
DATABASE_URL="file:./dev.db"
PORT=3001
# Production (Railway): set NODE_ENV=production and point SQLite at the volume, e.g.
# DATABASE_URL="file:/app/data/cinelog.db"
# Mount a Railway volume at /app/data
# Optional: GEMINI_MODEL=gemini-2.0-flash
